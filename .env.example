# Saskia Cleaning — environment variable template
# Copy to .env.local and fill in real values. Never commit .env.local.

# Database (Neon)
DATABASE_URL=
POSTGRES_PRISMA_URL=
DATABASE_URL_UNPOOLED=

# Admin access (Phase 11.13.2)
# Database admin_users is authoritative for Google admin login.
# ADMIN_EMAILS remains a temporary bootstrap fallback: if an email is listed
# here and has no admin_users row yet, an OWNER row is auto-created.
# After the seeded owner exists in production, you may leave ADMIN_EMAILS set
# as a safety net or remove it later.
# Example: ADMIN_EMAILS=olivierkfrancois1@gmail.com
ADMIN_EMAILS=

# Deprecated: DASHBOARD_KEY URL/query auth removed. Do not put keys in URLs.
# Kept only for reference during migration; unused by interactive admin UI/APIs.
# DASHBOARD_KEY=

# Email (Resend)
RESEND_API_KEY=
FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# OpenAI chatbot
OPENAI_API_KEY=

# Auth.js / NextAuth (Phase 11.1 — Google customer auth)
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional on some hosts; Auth.js v5 also supports AUTH_URL
# AUTH_URL=http://localhost:3000

# Internal cron (Phase 11.11 — capacity soft-release)
# Generate with: openssl rand -base64 32
# Used as: Authorization: Bearer <CRON_SECRET>
# Never use NEXT_PUBLIC_ prefix. Set the same value in Vercel env.
CRON_SECRET=
