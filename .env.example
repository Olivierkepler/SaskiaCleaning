# Saskia Cleaning — environment variable template
# Copy to .env.local and fill in real values. Never commit .env.local.

# Database (Neon)
DATABASE_URL=
POSTGRES_PRISMA_URL=
DATABASE_URL_UNPOOLED=

# Admin dashboard (unchanged — DASHBOARD_KEY auth)
DASHBOARD_KEY=

# Email (Resend)
RESEND_API_KEY=
FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# OpenAI chatbot
OPENAI_API_KEY=

# Auth.js / NextAuth (Phase 11.1 — Google customer auth)
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional on some hosts; Auth.js v5 also supports AUTH_URL
# AUTH_URL=http://localhost:3000
